# ──────────────────────────────────────────────
# Karbon API Configuration
# ──────────────────────────────────────────────
# Generate an API key at: Karbon > Settings > Connected Apps > API Keys
KARBON_ACCESS_KEY=your_karbon_access_key
# Your Karbon bearer token (provided alongside your access key)
KARBON_BEARER_TOKEN=your_karbon_bearer_token

# ──────────────────────────────────────────────
# Microsoft Graph / Outlook Configuration
# ──────────────────────────────────────────────
# Register an app at: https://portal.azure.com > App registrations
MICROSOFT_CLIENT_ID=your_azure_app_client_id
MICROSOFT_CLIENT_SECRET=your_azure_app_client_secret
MICROSOFT_TENANT_ID=your_azure_tenant_id
# After OAuth flow, these are populated automatically
MICROSOFT_ACCESS_TOKEN=
MICROSOFT_REFRESH_TOKEN=

# ──────────────────────────────────────────────
# Meta (Facebook) Marketing API Configuration
# ──────────────────────────────────────────────
# Create an app at: https://developers.facebook.com/apps/
# Generate a long-lived token via the Marketing API > Tools > Access Token Tool
META_ACCESS_TOKEN=your_meta_access_token
# Your ad account ID (numeric, without "act_" prefix)
META_AD_ACCOUNT_ID=your_ad_account_id
# Graph API version (default: v21.0)
META_API_VERSION=v21.0
# Your Meta Pixel ID (for conversion tracking)
META_PIXEL_ID=your_pixel_id
# Your Facebook Page ID (for ad creatives)
META_PAGE_ID=your_page_id

# ──────────────────────────────────────────────
# Canva Connect API Configuration
# ──────────────────────────────────────────────
# Create an integration at: https://www.canva.com/developers/
# Generate an access token via OAuth flow
CANVA_ACCESS_TOKEN=your_canva_access_token
