# ──────────────────────────────────────────────
# Karbon API Configuration
# ──────────────────────────────────────────────
# Generate an API key at: Karbon > Settings > Connected Apps > API Keys
KARBON_ACCESS_KEY=your_karbon_access_key
# Your Karbon bearer token (provided alongside your access key)
KARBON_BEARER_TOKEN=your_karbon_bearer_token

# ──────────────────────────────────────────────
# Microsoft Graph / Outlook Configuration
# ──────────────────────────────────────────────
# Register an app at: https://portal.azure.com > App registrations
MICROSOFT_CLIENT_ID=your_azure_app_client_id
MICROSOFT_CLIENT_SECRET=your_azure_app_client_secret
MICROSOFT_TENANT_ID=your_azure_tenant_id
# After OAuth flow, these are populated automatically
MICROSOFT_ACCESS_TOKEN=
MICROSOFT_REFRESH_TOKEN=

# ──────────────────────────────────────────────
# HubSpot (deal-owner lookup for Raven attribution)
# ──────────────────────────────────────────────
# Private app token. If unset, Raven's owner attribution skips HubSpot and
# uses the fallback path below.
HUBSPOT_ACCESS_TOKEN=

# ──────────────────────────────────────────────
# Raven — LAPS Sales Coordinator agent
# ──────────────────────────────────────────────
# Dedicated M365 SHARED mailbox. Raven uses Graph *application* auth
# (client-credentials) against this mailbox — provision + scope it with an
# Exchange Online Application Access Policy first. See docs/raven.md §3.
RAVEN_MAILBOX=raven@edlerzain.com
# Dedicated "Raven LAPS Agent" app registration. If blank, falls back to the
# shared MICROSOFT_* app creds above. Prefer a certificate over a secret in prod.
RAVEN_CLIENT_ID=
RAVEN_CLIENT_SECRET=
RAVEN_TENANT_ID=
# OPEN DECISION (§6, confirm with Mark): default 'on behalf of' owner when a
# lead has no HubSpot deal owner yet. Leave BLANK to hold such leads as
# unsigned drafts instead of defaulting to a closer. Example: "Jon Bock".
DEFAULT_OWNER_ON_UNASSIGNED=
# Hold unassigned leads as drafts when no default owner is set (default: true).
RAVEN_HOLD_UNASSIGNED_AS_DRAFT=true
# Soft launch (§9): route 100% of sends through HITL regardless of category.
# Keep true for the first 1–2 weeks, then set false to let low-risk categories
# (confirmations, reminders) auto-send.
RAVEN_SOFT_LAUNCH_GATE_ALL=true
# Where to append the JSONL audit trail (§7).
RAVEN_AUDIT_LOG_PATH=./logs/raven-audit.jsonl
