# ──────────────────────────────────────────────
# Karbon API Configuration
# ──────────────────────────────────────────────
# Generate an API key at: Karbon > Settings > Connected Apps > API Keys
KARBON_ACCESS_KEY=your_karbon_access_key
# Your Karbon bearer token (provided alongside your access key)
KARBON_BEARER_TOKEN=your_karbon_bearer_token

# ──────────────────────────────────────────────
# Microsoft Graph / Outlook Configuration
# ──────────────────────────────────────────────
# Register an app at: https://portal.azure.com > App registrations
MICROSOFT_CLIENT_ID=your_azure_app_client_id
MICROSOFT_CLIENT_SECRET=your_azure_app_client_secret
MICROSOFT_TENANT_ID=your_azure_tenant_id
# After OAuth flow, these are populated automatically
MICROSOFT_ACCESS_TOKEN=
MICROSOFT_REFRESH_TOKEN=
